#!/usr/bin/env node

import {loadConfig, loadLocalEnv} from "../src/config.js";
import {
  createGatewayServer,
  loadOrCreateLocalApiKey,
  resolveGatewayHost,
  rotateLocalApiKey
} from "../src/gateway/index.js";

loadLocalEnv();

const command = process.argv[2];

if (command === "key") {
  console.log(loadOrCreateLocalApiKey());
} else if (command === "rotate-key") {
  console.log(rotateLocalApiKey());
} else if (command === undefined) {
  startGateway();
} else {
  throw new Error(`Unknown gateway command: ${command}`);
}

function startGateway() {
  const config = loadConfig();
  const models = Array.isArray(config.baseModels) ? config.baseModels : [];
  const host = resolveGatewayHost(process.env.AUTOROUTER_HOST);
  const localApiKey = loadOrCreateLocalApiKey();
  const port = parsePort(process.env.AUTOROUTER_PORT);
  const server = createGatewayServer({localApiKey, models});

  server.listen(port, host, () => {
    console.log(`AutoRouter gateway listening on http://${host}:${port}`);
  });
}

function parsePort(value) {
  if (value === undefined) {
    return 8787;
  }

  const port = Number.parseInt(value, 10);

  if (!Number.isInteger(port) || port < 1 || port > 65535) {
    throw new Error("AUTOROUTER_PORT must be an integer between 1 and 65535");
  }

  return port;
}
